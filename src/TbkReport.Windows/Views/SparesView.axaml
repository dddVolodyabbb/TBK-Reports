<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TbkReport.ViewModels" xmlns:data="using:TbkReport.Services"
             x:Class="TbkReport.Views.SparesView" x:DataType="vm:SparesViewModel">
  <!-- The first two tabs look the same: search, «Добавить», the entry form (only while adding or editing) and the list. -->
  <TabControl Margin="12,8,12,0">
    <TabItem Header="В наличии">
      <ScrollViewer>
        <StackPanel Margin="20" Spacing="12">
          <TextBlock Text="ЗИП в наличии" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Пересчитайте ЗИП и укажите, на какой день он пересчитан. Количество показано за вычетом расхода из отчётов начиная с этого дня, пока включён учёт ЗИП."
                     TextWrapping="Wrap" Opacity="0.75" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Остатки на дату" VerticalAlignment="Center" FontWeight="SemiBold" />
            <DatePicker SelectedDate="{Binding StockDate, Mode=TwoWay}" DayFormat="dd" MonthFormat="MMMM" YearFormat="yyyy" />
          </StackPanel>
          <TextBlock Text="{Binding AccountingText}" TextWrapping="Wrap"
                     Foreground="{DynamicResource AccentTextBrush}" IsVisible="{Binding IsAccountingEnabled}" />
          <TextBlock Text="{Binding AccountingText}" TextWrapping="Wrap" Foreground="OrangeRed" IsVisible="{Binding !IsAccountingEnabled}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding StockSearch, Mode=TwoWay}" PlaceholderText="Поиск по наименованию, артикулу или производителю" />
            <Button Grid.Column="1" Content="+ Добавить" Command="{Binding OpenStockFormCommand}" IsVisible="{Binding !IsStockFormOpen}" />
          </Grid>
          <Border IsVisible="{Binding IsStockFormOpen}" BorderBrush="#FF0078D4" BorderThickness="1" CornerRadius="6" Padding="14">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding StockFormTitle}" FontSize="16" FontWeight="SemiBold" />
              <StackPanel Spacing="4" IsVisible="{Binding IsAddingStock}">
                <TextBlock Text="Комплектующая" />
                <TextBox x:Name="StockChoiceSearchBox" Text="{Binding StockChoiceSearch, Mode=TwoWay}" PlaceholderText="Найти в справочнике" />
                <Grid>
                  <ComboBox x:Name="StockChoiceList" ItemsSource="{Binding StockChoices}" SelectedItem="{Binding SelectedStockPart, Mode=TwoWay}"
                            PlaceholderText="Выберите из справочника" HorizontalAlignment="Stretch" MaxDropDownHeight="320">
                    <!-- Parts already in stock are offered too, in green with their quantity. -->
                    <ComboBox.Styles>
                      <Style Selector="TextBlock.InStock"><Setter Property="Foreground" Value="{DynamicResource InStockTextBrush}" /></Style>
                    </ComboBox.Styles>
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:SpareStockChoice">
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Classes.InStock="{Binding IsInStock}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Border IsVisible="{Binding IsStockPartInvalid}" BorderBrush="Red" BorderThickness="2" CornerRadius="4" IsHitTestVisible="False" />
                </Grid>
                <TextBlock Text="{Binding SelectedInStockText}" IsVisible="{Binding IsSelectedInStock}" TextWrapping="Wrap"
                           Foreground="{DynamicResource InStockTextBrush}" />
                <TextBlock Text="{Binding StockHint}" IsVisible="{Binding HasStockHint}" TextWrapping="Wrap" Foreground="OrangeRed" />
              </StackPanel>
              <!-- While a row is edited its part cannot be changed, only the quantity. -->
              <TextBlock Text="{Binding EditingStockLabel}" IsVisible="{Binding IsEditingStock}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <StackPanel Spacing="4" Width="160" HorizontalAlignment="Left"><TextBlock Text="Количество, шт." />
                <Grid><TextBox Text="{Binding StockQuantity, Mode=TwoWay}" />
                  <Border IsVisible="{Binding IsStockQuantityInvalid}" BorderBrush="Red" BorderThickness="2" CornerRadius="4" IsHitTestVisible="False" /></Grid></StackPanel>
              <TextBlock Text="{Binding StockValidation}" Foreground="OrangeRed" TextWrapping="Wrap"
                         IsVisible="{Binding StockValidation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding StockActionText}" Command="{Binding AddOrSaveStockCommand}" />
                <Button Content="Отмена" Command="{Binding CancelStockEditCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding StockSummary}" Opacity="0.75" />
          <Grid ColumnDefinitions="*,80,190" ColumnSpacing="8" IsVisible="{Binding HasStockRows}">
            <TextBlock Text="Наименование" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="Кол-во" FontWeight="SemiBold" />
          </Grid>
          <!-- As in the catalogue: the name, and under it «артикул · производитель». -->
          <ItemsControl ItemsSource="{Binding StockRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SpareStockRow">
                <Border BorderBrush="#40808080" BorderThickness="0,0,0,1" Padding="0,6">
                  <Grid ColumnDefinitions="*,80,190" ColumnSpacing="8">
                    <StackPanel VerticalAlignment="Center">
                      <SelectableTextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                      <SelectableTextBlock Text="{Binding Details}" IsVisible="{Binding HasDetails}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <SelectableTextBlock Grid.Column="1" Text="{Binding Quantity}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Content="Изменить" Click="EditStockClick" Padding="8,4" />
                      <Button Content="Удалить" Click="RemoveStockClick" Padding="8,4" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Комплектующие">
      <ScrollViewer>
        <StackPanel Margin="20" Spacing="12">
          <TextBlock Text="Справочник комплектующих" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Все комплектующие, которые вообще бывают. Количество здесь не указывается: оно ведётся на вкладке «В наличии»."
                     TextWrapping="Wrap" Opacity="0.75" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding PartsSearch, Mode=TwoWay}" PlaceholderText="Поиск по наименованию, артикулу или производителю" />
            <Button Grid.Column="1" Content="+ Добавить" Command="{Binding OpenPartFormCommand}" IsVisible="{Binding !IsPartFormOpen}" />
          </Grid>
          <Border IsVisible="{Binding IsPartFormOpen}" BorderBrush="#FF0078D4" BorderThickness="1" CornerRadius="6" Padding="14">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding PartFormTitle}" FontSize="16" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,200,180" ColumnSpacing="8">
                <StackPanel Spacing="4"><TextBlock Text="Наименование" />
                  <Grid><TextBox Text="{Binding PartName, Mode=TwoWay}" />
                    <Border IsVisible="{Binding IsPartNameInvalid}" BorderBrush="Red" BorderThickness="2" CornerRadius="4" IsHitTestVisible="False" /></Grid></StackPanel>
                <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Артикул (каталожный номер)" />
                  <TextBox Text="{Binding PartArticle, Mode=TwoWay}" /></StackPanel>
                <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Производитель" />
                  <AutoCompleteBox Text="{Binding PartManufacturer, Mode=TwoWay}" ItemsSource="{Binding Manufacturers}"
                                   FilterMode="StartsWith" MinimumPrefixLength="1" MinimumPopulateDelay="0:0:0" /></StackPanel>
              </Grid>
              <TextBlock Text="{Binding PartValidation}" Foreground="OrangeRed" TextWrapping="Wrap"
                         IsVisible="{Binding PartValidation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding PartActionText}" Command="{Binding AddOrSavePartCommand}" />
                <Button Content="Отмена" Command="{Binding CancelPartEditCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <!-- An error of «Удалить» (part still in stock) shows here while the form is closed. -->
          <TextBlock Text="{Binding PartValidation}" Foreground="OrangeRed" TextWrapping="Wrap" IsVisible="{Binding !IsPartFormOpen}" />
          <TextBlock Text="{Binding PartsSummary}" Opacity="0.75" />
          <!-- As in the equipment list: the name, and under it «артикул · производитель». -->
          <ItemsControl ItemsSource="{Binding Parts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="data:SparePart">
                <Border BorderBrush="#40808080" BorderThickness="0,0,0,1" Padding="0,6">
                  <Grid ColumnDefinitions="*,190" ColumnSpacing="8">
                    <StackPanel VerticalAlignment="Center">
                      <SelectableTextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                      <SelectableTextBlock Text="{Binding Details}" IsVisible="{Binding HasDetails}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Content="Изменить" Click="EditPartClick" Padding="8,4" />
                      <Button Content="Удалить" Click="RemovePartClick" Padding="8,4" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <!-- «Отчёт за месяц»: choose a month; it is checked at once for written-off spare parts; then «Создать отчёт» → PDF. -->
    <TabItem Header="Отчёт за месяц">
      <ScrollViewer DataContext="{Binding Month}" x:DataType="vm:SpareMonthReportViewModel">
        <StackPanel Margin="20" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
          <TextBlock Text="Расход ЗИП за месяц" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="В отчёт попадает весь ЗИП, списанный в отчётах за выбранный месяц. Отчёт сохраняется в PDF в папку экспорта."
                     TextWrapping="Wrap" Opacity="0.75" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Месяц" VerticalAlignment="Center" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth, Mode=TwoWay}" MinWidth="220"
                      PlaceholderText="Выберите месяц" IsVisible="{Binding HasMonths}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SpareMonthOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <TextBlock Text="{Binding MonthStatus}" TextWrapping="Wrap" IsVisible="{Binding CanCreate}"
                     Foreground="{DynamicResource AccentTextBrush}" />
          <TextBlock Text="{Binding MonthStatus}" TextWrapping="Wrap" IsVisible="{Binding !CanCreate}" Foreground="OrangeRed" />
          <Button Content="Создать отчёт" Command="{Binding CreateCommand}" IsEnabled="{Binding CanCreate}"
                  HorizontalAlignment="Left" MinHeight="40" Padding="16,8" />
          <Border IsVisible="{Binding IsReplacePromptVisible}" Background="#FFFFC107" Padding="12" CornerRadius="4">
            <StackPanel Spacing="8">
              <TextBlock Text="Отчёт за этот месяц уже есть в папке экспорта. Заменить?" Foreground="Black" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Заменить" Command="{Binding ConfirmReplaceCommand}" />
                <Button Content="Отмена" Command="{Binding CancelReplaceCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</UserControl>
