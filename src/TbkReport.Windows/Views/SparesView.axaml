<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TbkReport.ViewModels" xmlns:data="using:TbkReport.Services"
             x:Class="TbkReport.Views.SparesView" x:DataType="vm:SparesViewModel">
  <!-- Both tabs look the same: a table with «Изменить» / «Удалить» and an entry form below it. -->
  <TabControl Margin="12,8,12,0">
    <TabItem Header="В наличии">
      <ScrollViewer>
        <StackPanel Margin="20" Spacing="12">
          <TextBlock Text="ЗИП в наличии" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Заполняется один раз. Дальше количество уменьшается само, когда расход ЗИП сохраняется вместе с отчётом."
                     TextWrapping="Wrap" Opacity="0.75" />
          <Grid ColumnDefinitions="*,170,80,190" ColumnSpacing="8" IsVisible="{Binding HasStockRows}">
            <TextBlock Text="Наименование" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="Артикул" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Кол-во" FontWeight="SemiBold" />
          </Grid>
          <ItemsControl ItemsSource="{Binding StockRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SpareStockRow">
                <Border BorderBrush="#40808080" BorderThickness="0,0,0,1" Padding="0,6">
                  <Grid ColumnDefinitions="*,170,80,190" ColumnSpacing="8">
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Article}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Quantity}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                      <Button Content="Изменить" Click="EditStockClick" Padding="8,4" />
                      <Button Content="Удалить" Click="RemoveStockClick" Padding="8,4" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding StockHint}" IsVisible="{Binding HasStockHint}" TextWrapping="Wrap" Foreground="OrangeRed" />
          <Grid ColumnDefinitions="*,130" ColumnSpacing="8">
            <StackPanel Spacing="4"><TextBlock Text="Комплектующая" />
              <Grid>
                <ComboBox ItemsSource="{Binding StockChoices}" SelectedItem="{Binding SelectedStockPart, Mode=TwoWay}"
                          IsVisible="{Binding IsAddingStock}" PlaceholderText="Выберите из справочника"
                          HorizontalAlignment="Stretch" MaxDropDownHeight="320">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="data:SparePart"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <!-- While a row is edited its part cannot be changed, only the quantity. -->
                <TextBlock Text="{Binding EditingStockLabel}" IsVisible="{Binding IsEditingStock}" FontWeight="SemiBold"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Border IsVisible="{Binding IsStockPartInvalid}" BorderBrush="Red" BorderThickness="2" CornerRadius="4" IsHitTestVisible="False" />
              </Grid></StackPanel>
            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Количество, шт." />
              <Grid><TextBox Text="{Binding StockQuantity, Mode=TwoWay}" />
                <Border IsVisible="{Binding IsStockQuantityInvalid}" BorderBrush="Red" BorderThickness="2" CornerRadius="4" IsHitTestVisible="False" /></Grid></StackPanel>
          </Grid>
          <TextBlock Text="{Binding StockValidation}" Foreground="OrangeRed" TextWrapping="Wrap"
                     IsVisible="{Binding StockValidation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding StockActionText}" Command="{Binding AddOrSaveStockCommand}" />
            <Button Content="Отмена" Command="{Binding CancelStockEditCommand}" IsVisible="{Binding IsEditingStock}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Комплектующие">
      <ScrollViewer>
        <StackPanel Margin="20" Spacing="12">
          <TextBlock Text="Справочник комплектующих" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Все комплектующие, которые вообще бывают. Количество здесь не указывается: оно ведётся на вкладке «В наличии»."
                     TextWrapping="Wrap" Opacity="0.75" />
          <Grid ColumnDefinitions="*,170,80,190" ColumnSpacing="8" IsVisible="{Binding HasParts}">
            <TextBlock Text="Наименование" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="Артикул" FontWeight="SemiBold" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Parts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="data:SparePart">
                <Border BorderBrush="#40808080" BorderThickness="0,0,0,1" Padding="0,6">
                  <Grid ColumnDefinitions="*,170,80,190" ColumnSpacing="8">
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Article}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                      <Button Content="Изменить" Click="EditPartClick" Padding="8,4" />
                      <Button Content="Удалить" Click="RemovePartClick" Padding="8,4" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="*,220" ColumnSpacing="8">
            <StackPanel Spacing="4"><TextBlock Text="Наименование" />
              <Grid><TextBox Text="{Binding PartName, Mode=TwoWay}" />
                <Border IsVisible="{Binding IsPartNameInvalid}" BorderBrush="Red" BorderThickness="2" CornerRadius="4" IsHitTestVisible="False" /></Grid></StackPanel>
            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Артикул (каталожный номер)" />
              <TextBox Text="{Binding PartArticle, Mode=TwoWay}" /></StackPanel>
          </Grid>
          <TextBlock Text="{Binding PartValidation}" Foreground="OrangeRed" TextWrapping="Wrap"
                     IsVisible="{Binding PartValidation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding PartActionText}" Command="{Binding AddOrSavePartCommand}" />
            <Button Content="Отмена" Command="{Binding CancelPartEditCommand}" IsVisible="{Binding IsEditingPart}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</UserControl>
