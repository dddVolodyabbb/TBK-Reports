<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TbkReport.Views.ClockTimePicker">
  <Grid ColumnDefinitions="*,Auto">
    <TextBox Name="TimeTextBox" PlaceholderText="ЧЧ:ММ" MaxLength="5" VerticalContentAlignment="Center" />
    <TimePicker Name="WheelPicker" Grid.Column="1" Width="44" MinWidth="44" MaxWidth="44"
                Margin="6,0,0,0" ClockIdentifier="24HourClock" UseSeconds="False">
      <TimePicker.Template>
        <ControlTemplate>
          <Grid>
            <Button Name="PART_FlyoutButton" Content="◷" MinWidth="44"
                    AutomationProperties.Name="Открыть выбор времени" />
            <Popup Name="PART_Popup" PlacementTarget="{TemplateBinding}" Placement="Bottom"
                   IsLightDismissEnabled="True">
              <TimePickerPresenter Name="PART_PickerPresenter" />
            </Popup>
          </Grid>
        </ControlTemplate>
      </TimePicker.Template>
    </TimePicker>
  </Grid>
</UserControl>
