<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TbkReport.ViewModels"
             x:Class="TbkReport.Views.SettingsView" x:DataType="vm:MainViewModel">
  <UserControl.Styles>
    <Style Selector="ToggleSwitch">
      <Setter Property="OnContent" Value="Вкл" />
      <Setter Property="OffContent" Value="Выкл" />
    </Style>
    <Style Selector="RadioButton.CalculationSegment">
      <Setter Property="Background" Value="#252525" />
      <Setter Property="BorderBrush" Value="#71808C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="SegmentBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.CalculationSegment:checked">
      <Setter Property="Background" Value="#0078D4" />
    </Style>
    <Style Selector="RadioButton.CalculationSegment.Left /template/ Border#SegmentBorder">
      <Setter Property="CornerRadius" Value="7,0,0,7" />
    </Style>
    <Style Selector="RadioButton.CalculationSegment.Right /template/ Border#SegmentBorder">
      <Setter Property="CornerRadius" Value="0,7,7,0" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="← Назад" Command="{Binding CloseSettingsCommand}" />
        <Button Content="Сохранить" Command="{Binding SaveExportDirectoryCommand}" />
      </StackPanel>
      <TextBlock Text="Параметры" FontSize="22" FontWeight="SemiBold" />
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
        <TextBlock Text="Расчёт по" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Border Grid.Column="1" Background="#182D4055" CornerRadius="8" Padding="16,10">
          <Grid ColumnDefinitions="*,*" MaxWidth="520" HorizontalAlignment="Left">
            <RadioButton Classes="CalculationSegment Left" GroupName="CalculationMode" Content="Номерам стыков"
                         IsChecked="{Binding PendingCalculateByNumbers, Mode=TwoWay}" />
            <RadioButton Grid.Column="1" Classes="CalculationSegment Right" GroupName="CalculationMode" Content="Количеству стыков"
                         IsChecked="{Binding PendingCalculateByCount, Mode=TwoWay}" />
          </Grid>
        </Border>
      </Grid>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <TextBlock Text="Экспорт Excel одновременно с сохранением отчёта" VerticalAlignment="Center" TextWrapping="Wrap" />
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding PendingAutoExportExcel, Mode=TwoWay}" AutomationProperties.Name="Автоматический экспорт Excel" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <TextBlock Text="Экспорт PDF одновременно с сохранением отчёта" VerticalAlignment="Center" TextWrapping="Wrap" />
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding PendingAutoExportPdf, Mode=TwoWay}" AutomationProperties.Name="Автоматический экспорт PDF" />
      </Grid>
      <TextBlock Text="Папка для сохранения отчётов и резервных копий." TextWrapping="Wrap" />
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBox Text="{Binding ExportDirectory, Mode=TwoWay}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="Выбрать папку…" Click="BrowseFolderClick" />
        <Button Grid.Column="2" Content="Вернуть папку по умолчанию" Click="ResetExportFolderClick" />
      </Grid>
      <Separator />
      <Border Background="#182D4055" CornerRadius="8" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="Что включить в резервную копию" FontSize="18" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="24" RowSpacing="8">
            <CheckBox Content="История" IsChecked="{Binding DataTransfer.ExportHistory, Mode=TwoWay}" />
            <CheckBox Grid.Column="1" Content="Проблемы" IsChecked="{Binding DataTransfer.ExportProblems, Mode=TwoWay}" />
            <CheckBox Grid.Row="1" Content="Оборудование" IsChecked="{Binding DataTransfer.ExportEquipment, Mode=TwoWay}" />
            <CheckBox Grid.Row="1" Grid.Column="1" Content="Начальные данные" IsChecked="{Binding DataTransfer.ExportOpenings, Mode=TwoWay}" />
            <CheckBox Grid.Row="2" Content="Настройки" IsChecked="{Binding DataTransfer.ExportSettings, Mode=TwoWay}" />
            <CheckBox Grid.Row="2" Grid.Column="1" Content="Шапка" IsChecked="{Binding DataTransfer.ExportHeader, Mode=TwoWay}" />
            <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="Техники и подписи" IsChecked="{Binding DataTransfer.ExportTechnicians, Mode=TwoWay}" />
          </Grid>
          <TextBlock Text="Папка экспорта не переносится и остаётся своей на каждом устройстве."
                     Foreground="#FFB0B0B0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
        <!-- Export: arrow up out of the tray; import: arrow down into the tray. -->
        <Button Click="ExportDataClick" MinHeight="48" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Path Width="22" Height="22" Stretch="Uniform" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                  Stroke="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"
                  Data="M 4,15 L 4,20 L 20,20 L 20,15 M 12,15 L 12,3 M 7,8 L 12,3 L 17,8" />
            <TextBlock Text="Экспорт данных" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Click="ImportDataClick" MinHeight="48" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Path Width="22" Height="22" Stretch="Uniform" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                  Stroke="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"
                  Data="M 4,15 L 4,20 L 20,20 L 20,15 M 12,3 L 12,15 M 7,10 L 12,15 L 17,10" />
            <TextBlock Text="Импорт данных" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
      <Border IsVisible="{Binding DataTransfer.IsConfirmationVisible}" Padding="12" BorderBrush="Orange" BorderThickness="1">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding DataTransfer.Confirmation}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Импортировать" Command="{Binding DataTransfer.ConfirmImportCommand}" MinHeight="48" />
            <Button Content="Отмена" Command="{Binding DataTransfer.CancelImportCommand}" MinHeight="48" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Background="Black" CornerRadius="18" Padding="16,10"
              IsVisible="{Binding DataTransfer.HasStatus}" HorizontalAlignment="Center" MaxWidth="720">
        <TextBlock Text="{Binding DataTransfer.Status}" Foreground="{Binding DataTransfer.StatusForeground}"
                   TextWrapping="Wrap" TextAlignment="Center" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
