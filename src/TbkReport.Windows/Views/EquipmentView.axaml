<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TbkReport.ViewModels" xmlns:data="using:TbkReport.Services"
             x:Class="TbkReport.Views.EquipmentView" x:DataType="vm:EquipmentViewModel">
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="12">
      <TextBlock Text="Наличие оборудования" FontSize="20" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="data:EquipmentData">
            <Grid ColumnDefinitions="*,100,100,Auto,Auto" ColumnSpacing="8" Margin="0,4">
              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
              <TextBlock Grid.Column="1" Text="{Binding InWork, StringFormat='Рб: {0}'}" />
              <TextBlock Grid.Column="2" Text="{Binding InReserve, StringFormat='Рз: {0}'}" />
              <Button Grid.Column="3" Content="Изменить" Click="EditClick" Padding="8,4" />
              <Button Grid.Column="4" Content="Удалить" Click="RemoveClick" Padding="8,4" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid ColumnDefinitions="*,130,130" ColumnSpacing="8">
        <StackPanel Spacing="4"><TextBlock Text="Название оборудования" /><TextBox Text="{Binding DraftName, Mode=TwoWay}" /></StackPanel>
        <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="В работе (Рб)" /><TextBox Text="{Binding DraftInWork, Mode=TwoWay}" /></StackPanel>
        <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="В резерве (Рз)" /><TextBox Text="{Binding DraftInReserve, Mode=TwoWay}" /></StackPanel>
      </Grid>
      <TextBlock Text="{Binding Validation}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding ActionText}" Command="{Binding AddOrSaveCommand}" />
        <Button Content="Отмена" Command="{Binding CancelEditCommand}" IsVisible="{Binding IsEditing}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
