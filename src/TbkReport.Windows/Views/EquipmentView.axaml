<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TbkReport.ViewModels" xmlns:data="using:TbkReport.Services"
             x:Class="TbkReport.Views.EquipmentView" x:DataType="vm:EquipmentViewModel">
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="12">
      <TextBlock Text="Наличие оборудования" FontSize="20" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="data:EquipmentData">
            <Border BorderBrush="#40808080" BorderThickness="0,0,0,1" Padding="4,8">
              <Grid ColumnDefinitions="*,100,100,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{Binding InWork, StringFormat='Рб: {0}'}" />
                <TextBlock Grid.Column="2" Text="{Binding InReserve, StringFormat='Рз: {0}'}" />
                <Button Grid.Column="3" Content="Изменить" Click="EditClick" Padding="8,4" />
                <Button Grid.Column="4" Content="Удалить" Click="RemoveClick" Padding="8,4" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid ColumnDefinitions="*,130,130" ColumnSpacing="8">
        <!-- A red frame marks a field rejected by the last «Добавить оборудование». -->
        <StackPanel Spacing="4"><TextBlock Text="Название оборудования" />
          <Grid><TextBox Text="{Binding DraftName, Mode=TwoWay}" />
            <Border IsVisible="{Binding IsNameInvalid}" BorderBrush="Red" BorderThickness="2" CornerRadius="4" IsHitTestVisible="False" /></Grid></StackPanel>
        <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="В работе (Рб)" />
          <Grid><TextBox Text="{Binding DraftInWork, Mode=TwoWay}" />
            <Border IsVisible="{Binding IsInWorkInvalid}" BorderBrush="Red" BorderThickness="2" CornerRadius="4" IsHitTestVisible="False" /></Grid></StackPanel>
        <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="В резерве (Рз)" />
          <Grid><TextBox Text="{Binding DraftInReserve, Mode=TwoWay}" />
            <Border IsVisible="{Binding IsInReserveInvalid}" BorderBrush="Red" BorderThickness="2" CornerRadius="4" IsHitTestVisible="False" /></Grid></StackPanel>
      </Grid>
      <!-- Shown only with an error: an empty line here left a gap between the fields and the button. -->
      <TextBlock Text="{Binding Validation}" Foreground="OrangeRed" TextWrapping="Wrap"
                 IsVisible="{Binding Validation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding ActionText}" Command="{Binding AddOrSaveCommand}" />
        <Button Content="Отмена" Command="{Binding CancelEditCommand}" IsVisible="{Binding IsEditing}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
