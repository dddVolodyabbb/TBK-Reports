<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TbkReport.Mobile.Views.ClockTimePicker">
  <Grid ColumnDefinitions="*,Auto">
    <TextBox Name="TimeTextBox" PlaceholderText="ЧЧ:ММ" MaxLength="5" VerticalContentAlignment="Center"
             TextInputOptions.ContentType="Digits" TextInputOptions.ReturnKeyType="Done" />
    <TimePicker Name="WheelPicker" Grid.Column="1" Width="48" MinWidth="48" MaxWidth="48"
                MinHeight="48" Margin="6,0,0,0" VerticalAlignment="Stretch" ClockIdentifier="24HourClock" UseSeconds="False">
      <TimePicker.Template>
        <ControlTemplate>
          <Grid VerticalAlignment="Stretch">
            <!-- A drawn clock instead of the «◷» glyph: larger, exactly centred, in the button's text colour. -->
            <Button Name="PART_FlyoutButton" MinWidth="48" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" MinHeight="48" Padding="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    AutomationProperties.Name="Открыть выбор времени">
              <Path Width="24" Height="24" Stretch="Uniform" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                    Stroke="{Binding $parent[Button].Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Data="M 12,2 A 10,10 0 1 1 11.99,2 Z M 12,6 L 12,12 L 16,14" />
            </Button>
            <Popup Name="PART_Popup" PlacementTarget="{TemplateBinding}" Placement="Bottom"
                   HorizontalOffset="-190"
                   IsLightDismissEnabled="True">
              <TimePickerPresenter Name="PART_PickerPresenter" />
            </Popup>
          </Grid>
        </ControlTemplate>
      </TimePicker.Template>
    </TimePicker>
  </Grid>
</UserControl>
