<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TbkReport.ViewModels" xmlns:data="using:TbkReport.Services"
             x:Class="TbkReport.Mobile.Views.SpareStockView" x:DataType="vm:SparesViewModel"
             GotFocus="FormGotFocus" LostFocus="FormLostFocus">
  <!-- Same as the Windows «В наличии» tab: search, «Добавить», the form while adding or editing, and the list as cards. -->
  <ScrollViewer Name="FormScrollViewer" Focusable="True">
    <StackPanel Margin="16" Spacing="12">
      <TextBlock Text="Пересчитайте ЗИП и укажите, на какой день он пересчитан. Количество показано за вычетом расхода из отчётов начиная с этого дня, пока включён учёт ЗИП."
                 TextWrapping="Wrap" Opacity="0.75" />
      <TextBlock Text="Остатки на дату" FontWeight="SemiBold" />
      <DatePicker SelectedDate="{Binding StockDate, Mode=TwoWay}" DayFormat="dd" MonthFormat="MMMM" YearFormat="yyyy" HorizontalAlignment="Left" />
      <TextBlock Text="{Binding AccountingText}" TextWrapping="Wrap"
                 Foreground="{DynamicResource AccentTextBrush}" IsVisible="{Binding IsAccountingEnabled}" />
      <TextBlock Text="{Binding AccountingText}" TextWrapping="Wrap" Foreground="OrangeRed" IsVisible="{Binding !IsAccountingEnabled}" />
      <TextBox Text="{Binding StockSearch, Mode=TwoWay}" PlaceholderText="Поиск по наименованию или артикулу" MinHeight="48" />
      <Button Content="+ Добавить" Command="{Binding OpenStockFormCommand}" IsVisible="{Binding !IsStockFormOpen}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="56" />
      <Border Name="StockForm" IsVisible="{Binding IsStockFormOpen}" BorderBrush="#FF0078D4" BorderThickness="2" CornerRadius="8" Padding="12">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding StockFormTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
          <StackPanel Spacing="6" IsVisible="{Binding IsAddingStock}">
            <TextBlock Text="Комплектующая" />
            <TextBox Text="{Binding StockChoiceSearch, Mode=TwoWay}" PlaceholderText="Найти в справочнике" MinHeight="48" />
            <Grid>
              <ComboBox ItemsSource="{Binding StockChoices}" SelectedItem="{Binding SelectedStockPart, Mode=TwoWay}"
                        PlaceholderText="Выберите из справочника" HorizontalAlignment="Stretch" MinHeight="48" MaxDropDownHeight="420">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="data:SparePart"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Border IsVisible="{Binding IsStockPartInvalid}" BorderBrush="Red" BorderThickness="2" CornerRadius="4" IsHitTestVisible="False" />
            </Grid>
            <TextBlock Text="{Binding StockHint}" IsVisible="{Binding HasStockHint}" TextWrapping="Wrap" Foreground="OrangeRed" />
          </StackPanel>
          <!-- While a row is edited its part cannot be changed, only the quantity. -->
          <TextBlock Text="{Binding EditingStockLabel}" IsVisible="{Binding IsEditingStock}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="Количество, шт." />
          <Grid><TextBox Name="StockQuantityTextBox" Text="{Binding StockQuantity, Mode=TwoWay}" MinHeight="48" />
            <Border IsVisible="{Binding IsStockQuantityInvalid}" BorderBrush="Red" BorderThickness="2" CornerRadius="4" IsHitTestVisible="False" /></Grid>
          <TextBlock Text="{Binding StockValidation}" Foreground="OrangeRed" TextWrapping="Wrap"
                     IsVisible="{Binding StockValidation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Content="{Binding StockActionText}" Command="{Binding AddOrSaveStockCommand}" MinHeight="56"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Grid.Column="1" Content="Отмена" Command="{Binding CancelStockEditCommand}" MinHeight="56"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding StockSummary}" Opacity="0.75" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding StockRows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SpareStockRow">
            <Border BorderBrush="#40808080" BorderThickness="0,0,0,1" Padding="0,10">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                <SelectableTextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='{}{0} шт.'}" FontSize="18" FontWeight="SemiBold" />
                <SelectableTextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Article}" TextWrapping="Wrap" Opacity="0.7" />
                <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0">
                  <Button Content="Изменить" Click="EditClick" MinHeight="44" Margin="0,0,8,0" />
                  <Button Content="Удалить" Click="RemoveClick" MinHeight="44" />
                </WrapPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
