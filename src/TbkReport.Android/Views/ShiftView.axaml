<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:TbkReport.ViewModels" xmlns:models="using:TbkReport.Models" xmlns:views="using:TbkReport.Mobile.Views" xmlns:data="using:TbkReport.Services" x:Class="TbkReport.Mobile.Views.ShiftView" x:DataType="vm:ShiftViewModel"
             GotFocus="FormGotFocus" LostFocus="FormLostFocus">
  <UserControl.Styles>
    <!-- The comments / spare parts switch: the open half is filled with blue, readable in both themes. -->
    <Style Selector="Button.Segment">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="BorderBrush" Value="#71808C" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.Segment.Left"><Setter Property="CornerRadius" Value="7,0,0,7" /></Style>
    <Style Selector="Button.Segment.Right"><Setter Property="CornerRadius" Value="0,7,7,0" /></Style>
    <Style Selector="Button.Segment.Selected">
      <Setter Property="Background" Value="#FF0078D4" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.Segment.Selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FF0078D4" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer Name="ReportScrollViewer" Focusable="True">
    <StackPanel Margin="16" Spacing="12">
      <TextBlock Text="Сварочно-монтажные работы" TextWrapping="Wrap" FontSize="20" FontWeight="SemiBold" />
      <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
        <TextBlock Text="Время старта" />
        <TextBlock Grid.Row="2" Text="Время остановки" />
        <views:ClockTimePicker Grid.Row="1" SelectedTime="{Binding StartTime, Mode=TwoWay}" />
        <Border Grid.Row="1" IsVisible="{Binding IsStartTimeInvalid}" BorderBrush="Red" BorderThickness="2" CornerRadius="4" Background="Transparent" IsHitTestVisible="False" />
        <views:ClockTimePicker Grid.Row="3" SelectedTime="{Binding StopTime, Mode=TwoWay}" />
        <Border Grid.Row="3" IsVisible="{Binding IsStopTimeInvalid}" BorderBrush="Red" BorderThickness="2" CornerRadius="4" Background="Transparent" IsHitTestVisible="False" />
      </Grid>
      <StackPanel IsVisible="{Binding IsCountMode}" Spacing="8">
        <TextBlock Text="Сварено за смену" />
        <Grid>
          <TextBox Text="{Binding WeldedCountText, Mode=TwoWay}" MinWidth="0" TextInputOptions.ContentType="Digits" />
          <Border IsVisible="{Binding IsWeldedCountInvalid}" BorderBrush="Red" BorderThickness="2" CornerRadius="4" IsHitTestVisible="False" />
        </Grid>
        <TextBlock IsVisible="{Binding HasCountValidation}" Text="{Binding CountValidation}" Foreground="OrangeRed" TextWrapping="Wrap" />
      </StackPanel>
      <Grid IsVisible="{Binding IsNumberMode}" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
        <TextBlock Text="Первый стык №" />
        <TextBlock Grid.Column="1" Text="Последний стык №" TextWrapping="Wrap" />
        <TextBox Grid.Row="1" MinWidth="0" Text="{Binding FirstJoint, Mode=TwoWay}" TextInputOptions.ContentType="Digits" />
        <Border Grid.Row="1" IsVisible="{Binding IsFirstJointInvalid}" BorderBrush="Red" BorderThickness="2" CornerRadius="4" Background="Transparent" IsHitTestVisible="False" />
        <TextBox Grid.Row="1" Grid.Column="1" MinWidth="0" Text="{Binding LastJoint, Mode=TwoWay}" TextInputOptions.ContentType="Digits" />
        <Border Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsLastJointInvalid}" BorderBrush="Red" BorderThickness="2" CornerRadius="4" Background="Transparent" IsHitTestVisible="False" />
      </Grid>
      <TextBlock IsVisible="{Binding HasJointValidation}" Text="{Binding JointValidation}" Foreground="OrangeRed" TextWrapping="Wrap" />
      <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowSpacing="8">
        <TextBlock Text="Ремонтов за смену" VerticalAlignment="Center" TextWrapping="Wrap" />
        <TextBox Grid.Column="1" MinWidth="0" Text="{Binding Repairs, Mode=TwoWay}" TextInputOptions.ContentType="Digits" />
        <Border Grid.Column="1" IsVisible="{Binding IsRepairsInvalid}" BorderBrush="Red" BorderThickness="2" CornerRadius="4" Background="Transparent" IsHitTestVisible="False" />
      </Grid>
      <TextBlock IsVisible="{Binding HasRepairsValidation}" Text="{Binding RepairsValidation}" Foreground="OrangeRed" TextWrapping="Wrap" />
      <Border IsVisible="{Binding IsNumberMode}" Padding="20" Background="#182D4055" CornerRadius="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Сварено за смену" FontSize="18" VerticalAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Grid.Column="1" Text="{Binding Welded}" FontSize="32" FontWeight="SemiBold" />
        </Grid>
      </Border>
      <Border IsVisible="{Binding IsCountMode}" Padding="16" Background="#182D4055" CornerRadius="6">
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
          <TextBlock Text="Первый стык №" TextWrapping="Wrap" />
          <TextBlock Grid.Column="1" Text="Последний стык №" TextWrapping="Wrap" />
          <TextBlock Grid.Row="1" Text="{Binding FirstJointDisplay}" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastJointDisplay}" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Grid>
      </Border>
      <Separator />
      <!-- Comments and spare parts share the lower part of the shift: a two-part switch shows one of them. -->
      <Grid ColumnDefinitions="*,*">
        <Button Classes="Segment Left" Classes.Selected="{Binding IsCommentsPageOpen}" Content="Комментарии"
                Command="{Binding ShowCommentsCommand}" />
        <Button Grid.Column="1" Classes="Segment Right" Classes.Selected="{Binding IsSparesPageOpen}" Content="{Binding Spares.Header}"
                Command="{Binding ShowSparesCommand}" />
      </Grid>
      <StackPanel Spacing="12" IsVisible="{Binding IsCommentsPageOpen}">
      <TextBlock Text="Комментарии смены" FontSize="20" FontWeight="SemiBold" />
      <ItemsControl IsVisible="{Binding HasComments}" ItemsSource="{Binding Comments}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:ReportComment">
            <Border BorderBrush="#40808080" BorderThickness="0,0,0,1" Padding="4,8">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <TextBlock Text="{Binding TimeText}" VerticalAlignment="Top" FontWeight="SemiBold" />
                <StackPanel Grid.Column="1" Spacing="8">
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                  <WrapPanel HorizontalAlignment="Left">
                    <Button Content="Изменить" Margin="0,0,8,0" Padding="8,4" Click="EditCommentClick" />
                    <Button Content="Удалить" Padding="8,4" Click="RemoveCommentClick" />
                  </WrapPanel>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="Новый комментарий" FontSize="16" FontWeight="SemiBold" />
      <StackPanel Spacing="8">
        <CheckBox Content="Диапазон времени" IsChecked="{Binding IsCommentTimeRange, Mode=TwoWay}" />
        <TextBlock Text="Время / начало" />
        <views:ClockTimePicker SelectedTime="{Binding NewCommentTime, Mode=TwoWay}" />
        <TextBlock Text="Окончание" IsVisible="{Binding IsCommentEndTimeVisible}" />
        <views:ClockTimePicker SelectedTime="{Binding NewCommentEndTime, Mode=TwoWay}" IsVisible="{Binding IsCommentEndTimeVisible}" />
        <TextBox Name="CommentTextBox" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Text="{Binding NewCommentText, Mode=TwoWay}" PlaceholderText="Опишите событие" GotFocus="CommentTextBoxGotFocus" />
        <TextBlock Text="{Binding CommentValidation}" Foreground="Red" TextWrapping="Wrap" IsVisible="{Binding HasCommentValidation}" />
        <WrapPanel>
          <Button Content="{Binding CommentActionText}" Command="{Binding AddCommentCommand}" Margin="0,0,8,0" VerticalAlignment="Center" />
          <Button Content="Отмена" Command="{Binding CancelCommentEditCommand}" IsVisible="{Binding IsEditingComment}" VerticalAlignment="Center" />
        </WrapPanel>
      </StackPanel>
      </StackPanel>
      <StackPanel Spacing="12" IsVisible="{Binding IsSparesPageOpen}">
        <TextBlock Text="{Binding Spares.Hint}"
                   TextWrapping="Wrap" Opacity="0.75" />
        <ItemsControl IsVisible="{Binding Spares.HasItems}" ItemsSource="{Binding Spares.Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="data:SpareUsage">
              <Border BorderBrush="#40808080" BorderThickness="0,0,0,1" Padding="0,10">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='{}{0} шт.'}" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Article}" TextWrapping="Wrap" Opacity="0.7" />
                  <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0">
                    <Button Content="Изменить" Click="EditSpareClick" MinHeight="44" Margin="0,0,8,0" />
                    <Button Content="Удалить" Click="RemoveSpareClick" MinHeight="44" />
                  </WrapPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="В наличии нет ЗИП. Заполните раздел «В наличии» в меню «ЗИП»." TextWrapping="Wrap"
                   IsVisible="{Binding Spares.IsStockEmpty}" Foreground="OrangeRed" />
        <TextBlock Name="SpareFormTitle" Text="{Binding Spares.ActionText}" FontSize="16" FontWeight="SemiBold" />
        <TextBox Text="{Binding Spares.ChoiceSearch, Mode=TwoWay}" PlaceholderText="{Binding Spares.SearchPlaceholder}" MinHeight="48" />
        <TextBlock Text="Ничего не найдено." IsVisible="{Binding Spares.HasNoMatches}" Foreground="OrangeRed" />
        <Grid>
          <ComboBox ItemsSource="{Binding Spares.Choices}" SelectedItem="{Binding Spares.SelectedChoice, Mode=TwoWay}"
                    PlaceholderText="{Binding Spares.ChoicePlaceholder}" HorizontalAlignment="Stretch" MinHeight="48" MaxDropDownHeight="420">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SpareChoice"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Border IsVisible="{Binding Spares.IsPartInvalid}" BorderBrush="Red" BorderThickness="2" CornerRadius="4" IsHitTestVisible="False" />
        </Grid>
        <TextBlock Text="Количество, шт." />
        <Grid><TextBox Text="{Binding Spares.DraftQuantity, Mode=TwoWay}" MinHeight="48" />
          <Border IsVisible="{Binding Spares.IsQuantityInvalid}" BorderBrush="Red" BorderThickness="2" CornerRadius="4" IsHitTestVisible="False" /></Grid>
        <TextBlock Text="{Binding Spares.Validation}" Foreground="OrangeRed" TextWrapping="Wrap"
                   IsVisible="{Binding Spares.Validation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <Button Content="{Binding Spares.ActionText}" Command="{Binding Spares.AddOrSaveCommand}" MinHeight="56"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Grid.Column="1" Content="Отмена" Command="{Binding Spares.CancelEditCommand}" IsVisible="{Binding Spares.IsEditing}" MinHeight="56" />
        </Grid>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
