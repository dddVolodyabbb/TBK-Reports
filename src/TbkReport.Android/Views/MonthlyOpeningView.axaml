<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TbkReport.ViewModels" x:Class="TbkReport.Mobile.Views.MonthlyOpeningView" x:DataType="vm:ReportViewModel"
             GotFocus="FormGotFocus" LostFocus="FormLostFocus">
  <ScrollViewer Name="FormScrollViewer" Focusable="True">
    <StackPanel Margin="16" Spacing="8">
      <TextBlock Text="Приём начатого коллектора" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding MonthlyOpeningScope}" FontWeight="SemiBold" Foreground="#FF42A5F5" TextWrapping="Wrap" />
      <!-- The most common case comes first and in red: most users must not fill this page at all. -->
      <TextBlock Text="Если коллектор варится с первого стыка, здесь ничего заполнять не нужно!" TextWrapping="Wrap"
                 Foreground="#FFE53935" FontWeight="Bold" FontSize="17" />
      <TextBlock Text="Заполняйте этот раздел, только если принимаете коллектор, который уже начали варить другие техники, и их отчётов нет в программе." TextWrapping="Wrap" />
      <TextBlock Text="Значения возьмите из последнего отчёта техника, которого меняете. Они сохраняются для месяца из даты отчёта и для ГК из шапки." TextWrapping="Wrap" Opacity="0.7" />
      <TextBlock Text="Последний номер стыка" />
      <TextBox Text="{Binding MonthlyOpeningLastJoint, Mode=TwoWay}" PlaceholderText="Например, 274" />
      <TextBlock Text="Сварено стыков за месяц" />
      <TextBox Text="{Binding MonthlyOpeningWelded, Mode=TwoWay}" PlaceholderText="Например, 21" />
      <TextBlock Text="Ремонтов за месяц" />
      <TextBox Text="{Binding MonthlyOpeningRepairs, Mode=TwoWay}" PlaceholderText="Например, 3" />
      <TextBlock Text="Если какое-то значение неизвестно, оставьте поле пустым. Чтобы удалить ошибочные данные, очистите все три поля и нажмите «Сохранить начальные данные»." TextWrapping="Wrap" Opacity="0.7" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
