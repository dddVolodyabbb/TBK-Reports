  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="GemBox.Spreadsheet" Version="2026.9.128" />
    <PackageReference Include="SkiaSharp" Version="4.151.0" />
